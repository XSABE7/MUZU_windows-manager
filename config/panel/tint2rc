# MUZUwm Tint2 Status Bar Configuration
# Lightweight Top Bar with EWMH Struts

# Panel
panel_monitor = all
panel_position = top center horizontal
panel_size = 100% 30
panel_margin = 0 0
panel_padding = 6 2 6
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_layer = top
strut_policy = follow_size

# Background 1: Panel Frosted Dark Glass
rounded = 0
border_width = 1
border_sides = b
background_color = #16161e 90
border_color = #ffffff 15

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 4 2 4
taskbar_background_id = 0
taskbar_active_background_id = 0

# Clock
time1_format = %a %b %d  %H:%M
time1_font = sans-serif bold 10
time1_timezone = :
clock_font_color = #c0caf5 100
clock_padding = 6 0
clock_background_id = 0

# Systray
systray_padding = 4 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_aspecl = 1

# Order of items
panel_items = TESC
