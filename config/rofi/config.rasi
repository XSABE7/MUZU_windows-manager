/* MUZUwm macOS Frosted Glass Launcher Theme */
configuration {
    modi: "drun,run,window";
    font: "sans-serif 12";
    show-icons: true;
    terminal: "x-terminal-emulator";
    drun-display-format: "{name}";
}

@theme "/dev/null"

* {
    bg-col:  rgba(26, 27, 38, 0.85);
    border-col: rgba(255, 255, 255, 0.15);
    selected-col: rgba(65, 72, 104, 0.70);
    blue: #7aa2f7;
    fg-col: #c0caf5;
    fg-col2: #787c99;

    width: 600;
    background-color: transparent;
    text-color: @fg-col;
}

window {
    height: 380px;
    border: 1px;
    border-color: @border-col;
    border-radius: 12px;
    background-color: @bg-col;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    padding: 8px 12px;
    margin: 0px 0px 12px 0px;
}

prompt {
    text-color: @blue;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @fg-col2;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
}

element selected {
    background-color: @selected-col;
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}
